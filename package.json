{
  "name": "lazy-ps4",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "next build",
    "start": "next start",
    "app": "next build && electron .",
    "dist": "next build && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "https://github.com/castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.0.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^5.0.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.bruno.lazyps4",
    "productName": "Lazy PS4",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**",
      "!electron/**/*.test.js",
      "shared/**",
      "out/**",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "afterPack": "scripts/vmp-sign.js"
