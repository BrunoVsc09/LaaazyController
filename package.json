{
  "name": "laaazy",
  "productName": "Laaazy",
  "version": "3.3.0",
  "description": "Central de mídia para Windows com cara de console, controlada pelo DualShock 4: filmes, séries, animes, jogos e apps numa tela só.",
  "author": "Bruno <brunodev09@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/BrunoVsc09/LaaazyController#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrunoVsc09/LaaazyController.git"
  },
  "bugs": {
    "url": "https://github.com/BrunoVsc09/LaaazyController/issues"
  },
  "keywords": [
    "electron",
    "nextjs",
    "react",
    "media-center",
    "htpc",
    "dualshock4",
    "ds4windows",
    "gamepad",
    "tmdb",
    "gemini",
    "windows",
    "couch",
    "tdd"
  ],
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "next build",
    "start": "next start",
    "app": "pnpm preloads && next build && electron .",
    "dist": "pnpm preloads && next build && electron-builder && node scripts/package-check.js",
    "preloads": "node scripts/build-preloads.js",
    "icons": "electron scripts/make-icons.js"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "https://github.com/castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.0.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^5.0.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.bruno.laaazy",
    "productName": "Laaazy",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**",
      "!electron/**/*.test.js",
      "!electron/**/*.src.js",
      "shared/**",
      "!shared/**/*.test.js",
      "out/**",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Laaazy",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "Laaazy-Setup-${version}-x64.${ext}"
    },
    "portable": {
      "artifactName": "Laaazy-${version}-x64-portatil.${ext}"
    }
  }
}
